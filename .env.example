# ============================================================
# MZ BUILDING — variables d'environnement
# Copier ce fichier vers backend\.env puis remplir les valeurs (ne JAMAIS publier .env)
# ============================================================

# --- Base de données ---
# Doit commencer par postgresql+asyncpg:// (pilote asynchrone utilise par l'application).
# Supabase : bouton Connect > Transaction pooler, puis remplacer postgresql:// par postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.VOTRE_REF_PROJET:VOTRE_MOT_DE_PASSE@VOTRE_HOTE.pooler.supabase.com:6543/postgres

# --- Auth ---
# Generer une valeur aleatoire : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_moi_en_production
JWT_EXPIRATION_MINUTES=480

# --- Stockage documents ---
# STORAGE_DRIVER=local | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=mz-sitehub-docs

# --- IA ---
# AI_PROVIDER=ollama | openai | anthropic (openai/anthropic seulement si clé fournie)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- CORS (section 82) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Partage / liens sécurisés ---
SHARE_LINK_BASE_URL=http://localhost:5173/share
